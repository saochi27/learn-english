{"unit": 47, "so_cau": 50, "cau": [{"en": "Sorry, could you repeat the last part?", "vi": "Xin lỗi, bạn nhắc lại phần cuối được không?", "pa": {"cau": "Sorry, could you repeat the last part?", "ipa_day_du": "/ˈsɑːriː/ /kʊd/ /juː/ /rɪˈpiːt/ /ðə/ /læst/ /pɑːt/", "ipa_noi": "/ˈsɑːriː kə‿dʒə rɪˈpiːt ðə læst pɑːt/", "tho_noi": "sari-kơ-jơ-ripit-dhơ-last-pat", "tu": [{"tu": "Sorry", "ipa": "ˈsɑːriː", "nguon": "cmu"}, {"tu": "could", "ipa": "kʊd", "nguon": "cmu"}, {"tu": "you", "ipa": "juː", "nguon": "cmu"}, {"tu": "repeat", "ipa": "rɪˈpiːt", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "last", "ipa": "læst", "nguon": "cmu"}, {"tu": "part", "ipa": "pɑːt", "nguon": "cmu"}]}}, {"en": "Would you mind speaking a little slower?", "vi": "Bạn nói chậm hơn một chút được không?", "pa": {"cau": "Would you mind speaking a little slower?", "ipa_day_du": "/wʊd/ /juː/ /maɪnd/ /ˈspiːkɪŋ/ /ə/ /ˈlɪtəl/ /ˈsləʊə/", "ipa_noi": "/wə‿dʒə maɪnd ˈspiːkɪŋ‿ə ˈlɪtəl ˈsləʊə/", "tho_noi": "wơ-jơ-maind-spiking-ơ-litơl-slâuơ", "tu": [{"tu": "Would", "ipa": "wʊd", "nguon": "cmu"}, {"tu": "you", "ipa": "juː", "nguon": "cmu"}, {"tu": "mind", "ipa": "maɪnd", "nguon": "cmu"}, {"tu": "speaking", "ipa": "ˈspiːkɪŋ", "nguon": "cmu"}, {"tu": "a", "ipa": "ə", "nguon": "cmu"}, {"tu": "little", "ipa": "ˈlɪtəl", "nguon": "cmu"}, {"tu": "slower", "ipa": "ˈsləʊə", "nguon": "cmu"}]}}, {"en": "I didn't quite catch that.", "vi": "Tôi không nghe rõ.", "pa": {"cau": "I didn't quite catch that.", "ipa_day_du": "/aɪ/ /ˈdɪdənt/ /kwaɪt/ /kætʃ/ /ðæt/", "ipa_noi": "/aɪ ˈdɪdənt kwaɪt kætʃ ðæt/", "tho_noi": "ai-didơnt-kwait-kach-dhat", "tu": [{"tu": "I", "ipa": "aɪ", "nguon": "cmu"}, {"tu": "didn't", "ipa": "ˈdɪdənt", "nguon": "cmu"}, {"tu": "quite", "ipa": "kwaɪt", "nguon": "cmu"}, {"tu": "catch", "ipa": "kætʃ", "nguon": "cmu"}, {"tu": "that", "ipa": "ðæt", "nguon": "cmu"}]}}, {"en": "Did you say fifteen or fifty?", "vi": "Bạn nói mười lăm hay năm mươi?", "pa": {"cau": "Did you say fifteen or fifty?", "ipa_d