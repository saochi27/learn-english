ng", "cau_hoi": [{"so": 6, "de": "Ai đó giúp con. Con nói: ____", "dap_an": "Thank you", "nhan": ["Thank you"]}, {"so": 7, "de": "Con làm rơi đồ của bạn. Con nói: I am ____.", "dap_an": "sorry", "nhan": ["sorry"]}, {"so": 8, "de": "Con muốn xin nước. Con nói: Can I have water, ____?", "dap_an": "please", "nhan": ["please"]}, {"so": 9, "de": "Bạn cảm ơn con. Con nói: You are ____.", "dap_an": "welcome", "nhan": ["welcome"]}]}]}