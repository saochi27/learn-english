ther smiles.": "Bà bạn ấy mỉm cười."}, "cau": [{"en": "Nam is at the park with his grandmother.", "pa": {"cau": "Nam is at the park with his grandmother.", "ipa_day_du": "/næm/ /ɪz/ /æt/ /ðə/ /pɑːk/ /wɪð/ /hɪz/ /ˈɡrænmʌðə/", "ipa_noi": "/næm‿ɪz‿ət ðə pɑːk‿wɪð hɪz ˈɡrænmʌðə/", "tho_noi": "nam-iz-ơt-dhơ-pak-widh-hiz-granmâdhơ", "tu": [{"tu": "Nam", "ipa": "næm", "nguon": "cmu"}, {"tu": "is", "ipa": "ɪz", "nguon": "cmu"}, {"tu": "at", "ipa": "æt", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "park", "ipa": "pɑːk", "nguon": "cmu"}, {"tu": "with", "ipa": "wɪð", "nguon": "cmu"}, {"tu": "his", "ipa": "hɪz", "nguon": "cmu"}, {"tu": "grandmother", "ipa": "ˈɡrænmʌðə", "nguon": "giao_trinh"}]}, "vi": "Nam ở công viên với bà."}, {"en": "He sees three birds in the tree.", "pa": {"cau": "He sees three birds in the tree.", "ipa_day_du": "/hiː/ /siːz/ /θriː/ /bɜːdz/ /ɪn/ /ðə/ /triː/", "ipa_noi": "/i siːz θriː bɜːdz‿ɪn ðə triː/", "tho_noi": "i-siz-thri-bơdz-in-dhơ-tri", "tu": [{"tu": "He", "ipa": "hiː", "nguon": "cmu"}, {"tu": "sees", "ipa": "siːz", "nguon": "cmu"}, {"tu": "three", "ipa": "θriː", "nguon": "cmu"}, {"tu": "birds", "ipa": "bɜːdz", "nguon": "cmu"}, {"tu": "in", "ipa": "ɪn", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "tree", "ipa": "triː", "nguon": "cmu"}]}, "vi": "Bạn ấy thấy ba con chim trên cây."}, {"en": "He counts one, two, three.", "pa": {"cau": "He counts one, two, three.", "ipa_day_du": "/hiː/ /kaʊnts/ /wʌn/ /tuː/ /θriː/", "ipa_noi": "/i kaʊnts‿wʌn tuː θriː/", "tho_noi": "i-kaonts-wân-tu-thri", "tu": [{"tu": "He", "ipa": "hiː", "nguon": "cmu"}, {"tu": "counts", "ipa": "kaʊnts", "nguon": "cmu"}, {"tu": "one", "ipa": "wʌn", "nguon": "cmu"}, {"tu": "two", "ipa": "tuː", "nguon": "cmu"}, {"tu": "three", "ipa": "θriː", "nguon": "cmu"}]}, "vi": "Bạn ấy đếm một, hai, ba."}, {"en": "Then he sees two dogs.", "pa": {"cau": "Then he sees two dogs.", "ipa_day_du": "/ðen/ /hiː/ /siːz/ /tuː/ /dɑːɡz/", "ipa_noi": "/ðen‿i siːz tuː d