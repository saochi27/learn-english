a": "ə", "nguon": "cmu"}, {"tu": "clear", "ipa": "klɪə", "nguon": "cmu"}, {"tu": "example", "ipa": "ɪˈɡzæmpəl", "nguon": "cmu"}, {"tu": "of", "ipa": "ʌv", "nguon": "cmu"}, {"tu": "this", "ipa": "ðɪs", "nguon": "cmu"}, {"tu": "is", "ipa": "ɪz", "nguon": "cmu"}, {"tu": "remote", "ipa": "rɪˈməʊt", "nguon": "cmu"}, {"tu": "work", "ipa": "wɜːk", "nguon": "giao_trinh"}]}}, {"en": "Take education as an example.", "vi": "Lấy giáo dục làm ví dụ.", "pa": {"cau": "Take education as an example.", "ipa_day_du": "/teɪk/ /ˌedʒəˈkeɪʃən/ /æz/ /æn/ /ɪˈɡzæmpəl/", "ipa_noi": "/teɪk ˌedʒəˈkeɪʃən‿əz‿ən‿ɪˈɡzæmpəl/", "tho_noi": "tâyk-eyơkâyshơn-ơz-ơn-igzampơl", "tu": [{"tu": "Take", "ipa": "teɪk", "nguon": "cmu"}, {"tu": "education", "ipa": "ˌedʒəˈkeɪʃən", "nguon": "cmu"}, {"tu": "as", "ipa": "æz", "nguon": "cmu"}, {"tu": "an", "ipa": "æn", "nguon": "cmu"}, {"tu": "example", "ipa": "ɪˈɡzæmpəl", "nguon": "cmu"}]}}, {"en": "This can be seen in recent statistics.", "vi": "Điều này có thể thấy qua thống kê gần đây.", "pa": {"cau": "This can be seen in recent statistics.", "ipa_day_du": "/ðɪs/ /kæn/ /biː/ /siːn/ /ɪn/ /ˈriːsənt/ /stəˈtɪstɪks/", "ipa_noi": "/ðɪs kən biː siːn‿ɪn ˈriːsənt stəˈtɪstɪks/", "tho_noi": "dhis-kơn-bi-sin-in-risơnt-stơtistiks", "tu": [{"tu": "This", "ipa": "ðɪs", "nguon": "cmu"}, {"tu": "can", "ipa": "kæn", "nguon": "cmu"}, {"tu": "be", "ipa": "biː", "nguon": "cmu"}, {"tu": "seen", "ipa": "siːn", "nguon": "cmu"}, {"tu": "in", "ipa": "ɪn", "nguon": "cmu"}, {"tu": "recent", "ipa": "ˈriːsənt", "nguon": "cmu"}, {"tu": "statistics", "ipa": "stəˈtɪstɪks", "nguon": "cmu"}]}}, {"en": "By way of comparison, consider the rural figures.", "vi": "Để so sánh, hãy xét các số liệu nông thôn.", "pa": {"cau": "By way of comparison, consider the rural figures.", "ipa_day_du": "/baɪ/ /weɪ/ /ʌv/ /kəˈmperəsən/ /kənˈsɪdə/ /ðə/ /ˈrʊrəl/ /ˈfɪɡjəz/", "ipa_noi": "/baɪ weɪ əv kəˈmperəsən kənˈsɪdə ðə ˈrʊrəl ˈfɪɡjəz/", "tho_noi": "bai-wây-ơv-kơmperơsơn-kơnsidơ-dhơ-rurơl-figyơz", "tu": [{"tu": "By", "ipa": "baɪ", "nguon": "cmu"}, {"tu": "way", "ipa": "weɪ", "nguon": "cmu"}, {"tu": "of", "ipa": "ʌv", "nguon": "cmu"}, {"tu": "comparison", "ipa": "kəˈmperəsən", "nguon": "cmu"}, {"tu": "consider", "ipa": "kənˈsɪdə", "nguon": "giao_trinh"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "rural", "ipa": "ˈrʊrəl", "nguon": "cmu"}, {"tu": "figures", "ipa": "ˈfɪɡjəz", "nguon": "cmu"}]}}, {"en": "Similarly, the second group showed improvement.", "vi": "Tương tự, nhóm thứ hai cũng cải thiện.", "pa": {"cau": "Similarly, the second group showed improvement.", "ipa_day_du": "/ˈsɪmələliː/ /ðə/ /ˈsekənd/ /ɡruːp/ /ʃəʊd/ /ˌɪˈmpruːvmənt/", "ipa_noi": "/ˈsɪmələliː ðə ˈsekənd ɡruːp ʃəʊd ˌɪˈmpruːvmənt/", "tho_noi": "simơlơli-dhơ-sekơnd-grup-shâud-impruvmơnt", "tu": [{"tu": "Similarly", "ipa": "ˈsɪmələliː", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "second", "ipa": "ˈsekənd", "nguon": "cmu"}, {"tu": "group", "ipa": "ɡruːp", "nguon": "cmu"}, {"tu": "showed", "ipa": "ʃəʊd", "nguon": "cmu"}, {"tu": "improvement", "ipa": "ˌɪˈmpruːvmənt", "nguon": "cmu"}]}}, {"en": "Likewise, costs fell in the private sector.", "vi": "Cũng vậy, chi phí giảm ở khu vực tư.", "pa": {"cau": "Likewise, costs fell in the private sector.", "ipa_day_du": "/ˈlaɪˌkwaɪz/ /kɑːsts/ /fel/ /ɪn/ /ðə/ /ˈpraɪvət/ /ˈsektə/", "ipa_noi": "/ˈlaɪˌkwaɪz kɑːsts fel‿ɪn ðə ˈpraɪvət ˈsektə/", "tho_noi": "laikwaiz-kasts-fel-in-dhơ-praivơt-sektơ", "tu": [{"tu": "Likewise", "ipa": "ˈlaɪˌkwaɪz", "nguon": "cmu"}, {"tu": "costs", "ipa": "kɑːsts", "nguon": "cmu"}, {"tu": "fell", "ipa": "fel", "nguon": "cmu"}, {"tu": "in", "ipa": "ɪn", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "private", "ipa": "ˈpraɪvət", "nguon": "cmu"}, {"tu": "sector", "ipa": "ˈsektə", "nguon": "cmu"}]}}, {"en": "In contrast, the opposite occurred abroad.", "vi": "Trái lại, điều ngược lại xảy ra ở nước ngoài.", "pa": {"cau": "In contrast, the opposite occurred abroad.", "ipa_day_du": "/ɪn/ /ˈkɑːntræst/ /ðə/ /ˈɑːpəzət/ /əˈkɜːd/ /əˈbrɔːd/", "ipa_noi": "/ɪn ˈkɑːntræst ðə ˈɑːpəzət‿əˈkɜːd‿əˈbrɔːd/", "tho_noi": "in-kantrast-dhơ-apơzơt-ơkơd-ơbrod", "tu": [{"tu": "In", "ipa": "ɪn", "nguon": "cmu"}, {"tu": "contrast", "ipa": "ˈkɑːntræst", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "opposite", "ipa": "ˈɑːpəzət", "nguon": "cmu"}, {"tu": "occurred", "ipa": "əˈkɜːd", "nguon": "cmu"}, {"tu": "abroad", "ipa": "əˈbrɔːd", "nguon": "giao_trinh"}]}}, {"en": "Conversely, smaller firms benefited.", "vi": "Ngược lại, các công ty nhỏ hưởng lợi.", "pa": {"cau": "Conversely, smaller firms benefited.", "ipa_day_du": "/ˈkɑːnvəsliː/ /ˈsmɔːlə/ /fɜːmz/ /ˈbenəˌfɪtɪd/", "ipa_noi": "/ˈkɑːnvəsliː ˈsmɔːlə fɜːmz ˈbenəˌfɪtɪd/", "tho_noi": "kanvơsli-smolơ-fơmz-benơfitid", "tu": [{"tu": "Conversely", "ipa": "ˈkɑːnvəsliː", "nguon": "cmu"}, {"tu": "smaller", "ipa": "ˈsmɔːlə", "nguon": "cmu"}, {"tu": "firms", "ipa": "fɜːmz", "nguon": "cmu"}, {"tu": "benefited", "ipa": "ˈbenəˌfɪtɪd", "nguon": "cmu"}]}}, {"en": "On the contrary, participation increased.", "vi": "Trái lại, sự tham gia lại tăng.", "pa": {"cau": "On the contrary, participation increased.", "ipa_day_du": "/ɑːn/ /ðə/ /ˈkɑːntreriː/ /pɑːˌtɪsəˈpeɪʃən/ /ˌɪˈnkriːst/", "ipa_noi": "/ɑːn ðə ˈkɑːntreriː pɑːˌtɪsəˈpeɪʃən ˌɪˈnkriːst/", "tho_noi": "an-dhơ-kantreri-patisơpâyshơn-inkrist", "tu": [{"tu": "On", "ipa": "ɑːn", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "contrary", "ipa": "ˈkɑːntreriː", "nguon": "cmu"}, {"tu": "participation", "ipa": "pɑːˌtɪsəˈpeɪʃən", "nguon": "cmu"}, {"tu": "increased", "ipa": "ˌɪˈnkriːst", "nguon": "cmu"}]}}, {"en": "Instead of expanding, the company cut costs.", "vi": "Thay vì mở rộng, công ty cắt giảm chi phí.", "pa": {"cau": "Instead of expanding, the company cut costs.", "ipa_day_du": "/ˌɪˈnsted/ /ʌv/ /ɪˈkspændɪŋ/ /ðə/ /ˈkʌmpəni/ /kʌt/ /kɑːsts/", "ipa_noi": "/ˌɪˈnsted‿əv‿ɪˈkspændɪŋ ðə ˈkʌmpəni kʌt kɑːsts/", "tho_noi": "insted-ơv-ikspanding-dhơ-kâmpơni-kât-kasts", "tu": [{"tu": "Instead", "ipa": "ˌɪˈnsted", "nguon": "cmu"}, {"tu": "of", "ipa": "ʌv", "nguon": "cmu"}, {"tu": "expanding", "ipa": "ɪˈkspændɪŋ", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "company", "ipa": "ˈkʌmpəni", "nguon": "giao_trinh"}, {"tu": "cut", "ipa": "kʌt", "nguon": "cmu"}, {"tu": "costs", "ipa": "kɑːsts", "nguon": "cmu"}]}}, {"en": "In other words, the policy failed.", "vi": "Nói cách khác, chính sách đã thất bại.", "pa": {"cau": "In other words, the policy failed.", "ipa_day_du": "/ɪn/ /ˈʌðə/ /wɜːdz/ /ðə/ /ˈpɑːləsiː/ /feɪld/", "ipa_noi": "/ɪn ˈʌðə wɜːdz ðə ˈpɑːləsiː feɪld/", "tho_noi": "in-âdhơ-wơdz-dhơ-palơsi-fâyld", "tu": [{"tu": "In", "ipa": "ɪn", "nguon": "cmu"}, {"tu": "other", "ipa": "ˈʌðə", "nguon": "cmu"}, {"tu": "words", "ipa": "wɜːdz", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "policy", "ipa": "ˈpɑːləsiː", "nguon": "cmu"}, {"tu": "failed", "ipa": "feɪld", "nguon": "cmu"}]}}, {"en": "That is to say, results did not justify the cost.", "vi": "Nghĩa là kết quả không xứng với chi phí.", "pa": {"cau": "That is to say, results did not justify the cost.", "ipa_day_du": "/ðæt/ /ɪz/ /tuː/ /seɪ/ /rɪˈzʌlts/ /dɪd/ /nɑːt/ /ˈdʒʌstəˌfaɪ/ /ðə/ /kɑːst/", "ipa_noi": "/ðət‿ɪz tə seɪ rɪˈzʌlts dɪd nɑːt ˈdʒʌstəˌfaɪ ðə kɑːst/", "tho_noi": "dhơt-iz-tơ-sây-rizâlts-did-na-châstơfai-dhơ-kast", "tu": [{"tu": "That", "ipa": "ðæt", "nguon": "cmu"}, {"tu": "is", "ipa": "ɪz", "nguon": "cmu"}, {"tu": "to", "ipa": "tuː", "nguon": "giao_trinh"}, {"tu": "say", "ipa": "seɪ", "nguon": "cmu"}, {"tu": "results", "ipa": "rɪˈzʌlts", "nguon": "cmu"}, {"tu": "did", "ipa": "dɪd", "nguon": "cmu"}, {"tu": "not", "ipa": "nɑːt", "nguon": "cmu"}, {"tu": "justify", "ipa": "ˈdʒʌstəˌfaɪ", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "cost", "ipa": "kɑːst", "nguon": "cmu"}]}}, {"en": "To put it simply, nothing changed.", "vi": "Nói đơn giản, không có gì thay đổi.", "pa": {"cau": "To put it simply, nothing changed.", "ipa_day_du": "/tuː/ /pʊt/ /ɪt/ /ˈsɪmpliː/ /ˈnʌθɪŋ/ /tʃeɪndʒd/", "ipa_noi": "/tə pʊt‿ɪt ˈsɪmpliː ˈnʌθɪŋ tʃeɪndʒd/", "tho_noi": "tơ-put-it-simpli-nâthing-châynyd", "tu": [{"tu": "To", "ipa": "tuː", "nguon": "giao_trinh"}, {"tu": "put", "ipa": "pʊt", "nguon": "cmu"}, {"tu": "it", "ipa": "ɪt", "nguon": "cmu"}, {"tu": "simply", "ipa": "ˈsɪmpliː", "nguon": "cmu"}, {"tu": "nothing", "ipa": "ˈnʌθɪŋ", "nguon": "cmu"}, {"tu": "changed", "ipa": "tʃeɪndʒd", "nguon": "cmu"}]}}, {"en": "More precisely, the effect lasted six months.", "vi": "Chính xác hơn, tác động kéo dài sáu tháng.", "pa": {"cau": "More precisely, the effect lasted six months.", "ipa_day_du": "/mɔː/ /prɪˈsaɪsliː/ /ðə/ /ɪˈfekt/ /ˈlæstəd/ /sɪks/ /mʌnθs/", "ipa_noi": "/mɔː prɪˈsaɪsliː ðə ɪˈfekt ˈlæstəd sɪks mʌnθs/", "tho_noi": "mo-prisaisli-dhơ-ifekt-lastơd-siks-mânths", "tu": [{"tu": "More", "ipa": "mɔː", "nguon": "cmu"}, {"tu": "precisely", "ipa": "prɪˈsaɪsliː", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "effect", "ipa": "ɪˈfekt", "nguon": "cmu"}, {"tu": "lasted", "ipa": "ˈlæstəd", "nguon": "cmu"}, {"tu": "six", "ipa": "sɪks", "nguon": "cmu"}, {"tu": "months", "ipa": "mʌnθs", "nguon": "cmu"}]}}, {"en": "Consequently, the plan was abandoned.", "vi": "Do đó, kế hoạch bị bỏ.", "pa": {"cau": "Consequently, the plan was abandoned.", "ipa_day_du": "/ˈkɑːnsəkwəntliː/ /ðə/ /plæn/ /wɑːz/ /əˈbændənd/", "ipa_noi": "/ˈkɑːnsəkwəntliː ðə plæn‿wəz‿əˈbændənd/", "tho_noi": "kansơkwơntli-dhơ-plan-wơz-ơbandơnd", "tu": [{"tu": "Consequently", "ipa": "ˈkɑːnsəkwəntliː", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "plan", "ipa": "plæn", "nguon": "giao_trinh"}, {"tu": "was", "ipa": "wɑːz", "nguon": "cmu"}, {"tu": "abandoned", "ipa": "əˈbændənd", "nguon": "cmu"}]}}, {"en": "Accordingly, new measures were introduced.", "vi": "Theo đó, các biện pháp mới được đưa ra.", "pa": {"cau": "Accordingly, new measures were introduced.", "ipa_day_du": "/əˈkɔːdɪŋliː/ /nuː/ /ˈmeʒəz/ /wɜː/ /ˌɪntrəˈduːst/", "ipa_noi": "/əˈkɔːdɪŋliː nuː ˈmeʒəz‿wə ˌɪntrəˈduːst/", "tho_noi": "ơkodingli-nu-mezhơz-wơ-intrơdust", "tu": [{"tu": "Accordingly", "ipa": "əˈkɔːdɪŋliː", "nguon": "cmu"}, {"tu": "new", "ipa": "nuː", "nguon": "cmu"}, {"tu": "measures", "ipa": "ˈmeʒəz", "nguon": "cmu"}, {"tu": "were", "ipa": "wɜː", "nguon": "cmu"}, {"tu": "introduced", "ipa": "ˌɪntrəˈduːst", "nguon": "cmu"}]}}, {"en": "For this reason, funding was increased.", "vi": "Vì lý do này, tài trợ được tăng.", "pa": {"cau": "For this reason, funding was increased.", "ipa_day_du": "/fɔː/ /ðɪs/ /ˈriːzən/ /ˈfʌndɪŋ/ /wɑːz/ /ˌɪˈnkriːst/", "ipa_noi": "/fə ðɪs ˈriːzən ˈfʌndɪŋ‿wəz ˌɪˈnkriːst/", "tho_noi": "fơ-dhis-rizơn-fânding-wơz-inkrist", "tu": [{"tu": "For", "ipa": "fɔː", "nguon": "giao_trinh"}, {"tu": "this", "ipa": "ðɪs", "nguon": "cmu"}, {"tu": "reason", "ipa": "ˈriːzən", "nguon": "cmu"}, {"tu": "funding", "ipa": "ˈfʌndɪŋ", "nguon": "cmu"}, {"tu": "was", "ipa": "wɑːz", "nguon": "cmu"}, {"tu": "increased", "ipa": "ˌɪˈnkriːst", "nguon": "cmu"}]}}, {"en": "Hence the need for careful planning.", "vi": "Vì thế cần lập kế hoạch cẩn thận.", "pa": {"cau": "Hence the need for careful planning.", "ipa_day_du": "/hens/ /ðə/ /niːd/ /fɔː/ /ˈkeəfəl/ /ˈplænɪŋ/", "ipa_noi": "/hens ðə niːd fə ˈkeəfəl ˈplænɪŋ/", "tho_noi": "hens-dhơ-nid-fơ-kefơl-planing", "tu": [{"tu": "Hence", "ipa": "hens", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "need", "ipa": "niːd", "nguon": "cmu"}, {"tu": "for", "ipa": "fɔː", "nguon": "giao_trinh"}, {"tu": "careful", "ipa": "ˈkeəfəl", "nguon": "cmu"}, {"tu": "planning", "ipa": "ˈplænɪŋ", "nguon": "cmu"}]}}, {"en": "Thus the argument becomes circular.", "vi": "Vì vậy lập luận trở nên luẩn quẩn.", "pa": {"cau": "Thus the argument becomes circular.", "ipa_day_du": "/ðʌs/ /ðə/ /ˈɑːɡjəmənt/ /bɪˈkʌmz/ /ˈsɜːkjələ/", "ipa_noi": "/ðʌs ðə ˈɑːɡjəmənt bɪˈkʌmz ˈsɜːkjələ/", "tho_noi": "dhâs-dhơ-agyơmơnt-bikâmz-sơkyơlơ", "tu": [{"tu": "Thus", "ipa": "ðʌs", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "argument", "ipa": "ˈɑːɡjəmənt", "nguon": "cmu"}, {"tu": "becomes", "ipa": "bɪˈkʌmz", "nguon": "cmu"}, {"tu": "circular", "ipa": "ˈsɜːkjələ", "nguon": "cmu"}]}}, {"en": "Nonetheless, progress has been made.", "vi": "Dù vậy, đã có tiến bộ.", "pa": {"cau": "Nonetheless, progress has been made.", "ipa_day_du": "/ˌnʌnðəˈles/ /ˈprɑːˌɡres/ /hæz/ /bɪn/ /meɪd/", "ipa_noi": "/ˌnʌnðəˈles ˈprɑːˌɡres həz bɪn meɪd/", "tho_noi": "nândhơles-pragres-hơz-bin-mâyd", "tu": [{"tu": "Nonetheless", "ipa": "ˌnʌnðəˈles", "nguon": "cmu"}, {"tu": "progress", "ipa": "ˈprɑːˌɡres", "nguon": "cmu"}, {"tu": "has", "ipa": "hæz", "nguon": "cmu"}, {"tu": "been", "ipa": "bɪn", "nguon": "cmu"}, {"tu": "made", "ipa": "meɪd", "nguon": "cmu"}]}}, {"en": "Even so, the problem persists.", "vi": "Dù thế, vấn đề vẫn tồn tại.", "pa": {"cau": "Even so, the problem persists.", "ipa_day_du": "/ˈiːvɪn/ /səʊ/ /ðə/ /ˈprɑːbləm/ /pəˈsɪsts/", "ipa_noi": "/ˈiːvɪn səʊ ðə ˈprɑːbləm pəˈsɪsts/", "tho_noi": "ivin-sâu-dhơ-prablơm-pơsists", "tu": [{"tu": "Even", "ipa": "ˈiːvɪn", "nguon": "cmu"}, {"tu": "so", "ipa": "səʊ", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "problem", "ipa": "ˈprɑːbləm", "nguon": "cmu"}, {"tu": "persists", "ipa": "pəˈsɪsts", "nguon": "cmu"}]}}, {"en": "Admittedly, the sample was small.", "vi": "Phải thừa nhận, mẫu còn nhỏ.", "pa": {"cau": "Admittedly, the sample was small.", "ipa_day_du": "/æˈdmɪtɪdliː/ /ðə/ /ˈsæmpəl/ /wɑːz/ /smɔːl/", "ipa_noi": "/æˈdmɪtɪdliː ðə ˈsæmpəl‿wəz smɔːl/", "tho_noi": "admitidli-dhơ-sampơl-wơz-smol", "tu": [{"tu": "Admittedly", "ipa": "æˈdmɪtɪdliː", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "sample", "ipa": "ˈsæmpəl", "nguon": "cmu"}, {"tu": "was", "ipa": "wɑːz", "nguon": "cmu"}, {"tu": "small", "ipa": "smɔːl", "nguon": "cmu"}]}}, {"en": "Granted, the cost is high.", "vi": "Đúng là chi phí cao.", "pa": {"cau": "Granted, the cost is high.", "ipa_day_du": "/ˈɡræntəd/ /ðə/ /kɑːst/ /ɪz/ /haɪ/", "ipa_noi": "/ˈɡræntəd ðə kɑːst‿ɪz h