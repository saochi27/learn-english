": "cmu"}, {"tu": "I", "ipa": "aɪ", "nguon": "cmu"}, {"tu": "did", "ipa": "dɪd", "nguon": "cmu"}, {"tu": "not", "ipa": "nɑːt", "nguon": "cmu"}, {"tu": "save", "ipa": "seɪv", "nguon": "giao_trinh"}, {"tu": "them", "ipa": "ðem", "nguon": "cmu"}, {"tu": "anywhere", "ipa": "ˈeniːˌweə", "nguon": "cmu"}]}}, {"vai": "A", "en": "That is bad luck. What did you do then?", "vi": "Xui thật. Rồi bạn làm gì?", "them": true, "pa": {"cau": "That is bad luck. What did you do then?", "ipa_day_du": "/ðæt/ /ɪz/ /bæd/ /lʌk/ /wʌt/ /dɪd/ /juː/ /duː/ /ðen/", "ipa_noi": "/ðət‿ɪz bæd lʌk‿wʌt dɪ‿dʒə də ðen/", "tho_noi": "dhơt-iz-bad-lâk-wât-di-jơ-dơ-dhen", "tu": [{"tu": "That", "ipa": "ðæt", "nguon": "cmu"}, {"tu": "is", "ipa": "ɪz", "nguon": "cmu"}, {"tu": "bad", "ipa": "bæd", "nguon": "cmu"}, {"tu": "luck", "ipa": "lʌk", "nguon": "cmu"}, {"tu": "What", "ipa": "wʌt", "nguon": "cmu"}, {"tu": "did", "ipa": "dɪd", "nguon": "cmu"}, {"tu": "you", "ipa": "juː", "nguon": "cmu"}, {"tu": "do", "ipa": "duː", "nguon": "cmu"}, {"tu": "then", "ipa": "ðen", "nguon": "giao_trinh"}]}}, {"vai": "B", "en": "I went to the shop and bought a cheap one.", "vi": "Tôi ra cửa hàng mua một cái rẻ tiền.", "them": true, "pa": {"cau": "I went to the shop and bought a cheap one.", "ipa_day_du": "/aɪ/ /went/ /tuː/ /ðə/ /ʃɑːp/ /ənd/ /bɑːt/ /ə/ /tʃiːp/ /wʌn/", "ipa_noi": "/aɪ went tə ðə ʃɑːp‿ən bɑːt‿ə tʃiːp‿wʌn/", "tho_noi": "ai-went-tơ-dhơ-shap-ơn-bat-ơ-chip-wân", "tu": [{"tu": "I", "ipa": "aɪ", "nguon": "cmu"}, {"tu": "went", "ipa": "went", "nguon": "cmu"}, {"tu": "to", "ipa": "tuː", "nguon": "giao_trinh"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "shop", "ipa": "ʃɑːp", "nguon": "cmu"}, {"tu": "and", "ipa": "ənd", "nguon": "cmu"}, {"tu": "bought", "ipa": "bɑːt", "nguon": "cmu"}, {"tu": "a", "ipa": "ə", "nguon": "cmu"}, {"tu": "cheap", "ipa": "tʃiːp", "nguon": "giao_trinh"}, {"tu": "one", "ipa": "wʌn", "nguon": "cmu"}]}}, {"vai": "A", "en": "At least you can call people now.", "vi": "Ít ra giờ bạn gọi được cho mọi người.", "them": true, "pa": {"cau": "At least you can call people now.", "ipa_day_du": "/æt/ /liːst/ /juː/ /kæn/ /kɔːl/ /ˈpiːpəl/ /naʊ/", "ipa_noi": "/ət liːs‿tʃə kən kɔːl ˈpiːpəl naʊ/", "tho_noi": "ơt-lis-chơ-kơn-kol-pipơl-nao", "tu": [{"tu": "At", "ipa": "æt", "nguon": "cmu"}, {"tu": "least", "ipa": "liːst", "nguon": "cmu"}, {"tu": "you", "ipa": "juː", "nguon": "cmu"}, {"tu": "can", "ipa": "kæn", "nguon": "cmu"}, {"tu": "call", "ipa": "kɔːl", "nguon": "cmu"}, {"tu": "people", "ipa": "ˈpiːpəl", "nguon": "cmu"}, {"tu": "now", "ipa": "naʊ", "nguon": "cmu"}]}}, {"vai": "B", "en": "True. And I saved everything to the cloud.", "vi": "Đúng vậy. Và tôi đã lưu hết lên đám mây.", "them": true, "pa": {"cau": "True. And I saved everything to the cloud.", "ipa_day_du": "/truː/ /ənd/ /aɪ/ /seɪvd/ /ˈevriːˌθɪŋ/ /tuː/ /ðə/ /klaʊd/", "ipa_noi": "/truː ən‿aɪ seɪvd ˈevriːˌθɪŋ tə ðə klaʊd/", "tho_noi": "tru-ơn-ai-sâyvd-evrithing-tơ-dhơ-klaod", "tu": [{"tu": "True", "ipa": "truː", "nguon": "cmu"}, {"tu": "And", "ipa": "ənd", "nguon": "cmu"}, {"tu": "I", "ipa": "aɪ", "nguon": "cmu"}, {"tu": "saved", "ipa": "seɪvd", "nguon": "cmu"}, {"tu": "everything", "ipa": "ˈevriːˌθɪŋ", "nguon": "cmu"}, {"tu": "to", "ipa": "tuː", "nguon": "giao_trinh"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "cloud", "ipa": "klaʊd", "nguon": "cmu"}]}}], "them": true}], "doan_van": [{"ten": "Bảng 40 động từ bất quy tắc bắt buộc thuộc", "noi_dung": "Học theo **nhóm quy luật** — nhanh hơn học danh sách ABC rất nhiều.\n\n**Nhóm 1: Không đổi (V1 = V2)**\ncut–cut · put–put · let–let · set–set · hit–hit · cost–cost · read–read (đọc là /red/ ở V2!)\n\n**Nhóm 2: Đổi nguyên âm i → a → u**\ndrink–drank · sing–sang · swim–swam · begin–began · ring–rang\n\n**Nhóm 3: Đổi i → o**\ndrive–drove · ride–rode · write–wrote · rise–rose\n\n**Nhóm 4: Đổi e/ee → e ngắn**\nmeet–met · feel–felt · keep–kept · sleep–slept · leave–left · read–read\n\n**Nhóm 5: Thêm -ought / -aught**\nbuy–bought · bring–brought · think–thought · teach–taught · catch–caught\n\n**Nhóm 6: Bất quy tắc hoàn toàn (phải thuộc lòng)**\ngo–**went** · be–**was/were** · have–**had** · do–**did** · make–**made** · take–**took** · get–**got** · give–**gave** · see–**saw** · come–**came** · say–**said** (đọc /sed/) · eat–**ate** · know–**knew** · find–**found** · tell–**told**", "cau": [{"en": "drink–drank · sing–sang · swim–swam · begin–began · ring–rang", "pa": {"cau": "drink–drank · sing–sang · swim–swam · begin–began · ring–rang", "ipa_day_du": "/drɪŋk/ /dræŋk/ /sɪŋ/ /sæŋ/ /swɪm/ /swæm/ /bɪˈɡɪn/ /bɪˈɡæn/ /rɪŋ/ /ræŋ/", "ipa_noi": "/drɪŋk dræŋk sɪŋ sæŋ swɪm swæm bɪˈɡɪn bɪˈɡæn rɪŋ ræŋ/", "tho_noi": "dringk-drangk-sing-sang-swim-swam-bigin-bigan-ring-rang", "tu": [{"tu": "drink", "ipa": "drɪŋk", "nguon": "cmu"}, {"tu": "drank", "ipa": "dræŋk", "nguon": "cmu"}, {"tu": "sing", "ipa": "sɪŋ", "nguon": "cmu"}, {"tu": "sang", "ipa": "sæŋ", "nguon": "cmu"}, {"tu": "swim", "ipa": "swɪm", "nguon": "cmu"}, {"tu": "swam", "ipa": "swæm", "nguon": "cmu"}, {"tu": "begin", "ipa": "bɪˈɡɪn", "nguon": "cmu"}, {"tu": "began", "ipa": "bɪˈɡæn", "nguon": "cmu"}, {"tu": "ring", "ipa": "rɪŋ", "nguon": "cmu"}, {"tu": "rang", "ipa": "ræŋ", "nguon": "cmu"}]}, "vi": ""}, {"en": "drive–drove · ride–rode · write–wrote · rise–rose", "pa": {"cau": "drive–drove · ride–rode · write–wrote · rise–rose", "ipa_day_du": "/draɪv/ /drəʊv/ /raɪd/ /rəʊd/ /raɪt/ /rəʊt/ /raɪz/ /rəʊz/", "ipa_noi": "/draɪv drəʊv raɪd rəʊd raɪt rəʊt raɪz rəʊz/", "tho_noi": "draiv-drâuv-raid-râud-rait-râut-raiz-râuz", "tu": [{"tu": "drive", "ipa": "draɪv", "nguon": "cmu"}, {"tu": "drove", "ipa": "drəʊv", "nguon": "cmu"}, {"tu": "ride", "ipa": "raɪd", "nguon": "cmu"}, {"tu": "rode", "ipa": "rəʊd", "nguon": "cmu"}, {"tu": "write", "ipa": "raɪt", "nguon": "cmu"}, {"tu": "wrote", "ipa": "rəʊt", "nguon": "cmu"}, {"tu": "rise", "ipa": "raɪz", "nguon": "cmu"}, {"tu": "rose", "ipa": "rəʊz", "nguon": "cmu"}]}, "vi": ""}, {"en": "meet–met · feel–felt · keep–kept · sleep–slept · leave–left · read–read", "pa": {"cau": "meet–met · feel–felt · keep–kept · sleep–slept · leave–left · read–read", "ipa_day_du": "/miːt/ /met/ /fiːl/ /felt/ /kiːp/ /kept/ /sliːp/ /slept/ /liːv/ /left/ /red/ /red/", "ipa_noi": "/miːt met fiːl felt kiːp kept sliːp slept liːv left red red/", "tho_noi": "mit-met-fil-felt-kip-kept-slip-slept-liv-left-red-red", "tu": [{"tu": "meet", "ipa": "miːt", "nguon": "giao_trinh"}, {"tu": "met", "ipa": "met", "nguon": "cmu"}, {"tu": "feel", "ipa": "fiːl", "nguon": "cmu"}, {"tu": "felt", "ipa": "felt", "nguon": "cmu"}, {"tu": "keep", "ipa": "kiːp", "nguon": "cmu"}, {"tu": "kept", "ipa": "kept", "nguon": "cmu"}, {"tu": "sleep", "ipa": "sliːp", "nguon": "cmu"}, {"tu": "slept", "ipa": "slept", "nguon": "cmu"}, {"tu": "leave", "ipa": "liːv", "nguon": "cmu"}, {"tu": "left", "ipa": "left", "nguon": "cmu"}, {"tu": "read", "ipa": "red", "nguon": "cmu"}, {"tu": "read", "ipa": "red", "nguon": "cmu"}]}, "vi": ""}, {"en": "buy–bought · bring–brought · think–thought · teach–taught · catch–caught", "pa": {"cau": "buy–bought · bring–brought · think–thought · teach–taught · catch–caught", "ipa_day_du": "/baɪ/ /bɑːt/ /brɪŋ/ /brɔːt/ /θɪŋk/ /θɔːt/ /tiːtʃ/ /tɔːt/ /kætʃ/ /kɑːt/", "ipa_noi": "/baɪ bɑːt brɪŋ brɔːt θɪŋk θɔːt tiːtʃ tɔːt kætʃ kɑːt/", "tho_noi": "bai-bat-bring-brot-thingk-thot-tich-tot-kach-kat", "tu": [{"tu": "buy", "ipa": "baɪ", "nguon": "cmu"}, {"tu": "bought", "ipa": "bɑːt", "nguon": "cmu"}, {"tu": "bring", "ipa": "brɪŋ", "nguon": "cmu"}, {"tu": "brought", "ipa": "brɔːt", "nguon": "cmu"}, {"tu": "think", "ipa": "θɪŋk", "nguon": "cmu"}, {"tu": "thought", "ipa": "θɔːt", "nguon": "cmu"}, {"tu": "teach", "ipa": "tiːtʃ", "nguon": "cmu"}, {"tu": "taught", "ipa": "tɔːt", "nguon": "cmu"}, {"tu": "catch", "ipa": "kætʃ", "nguon": "cmu"}, {"tu": "caught", "ipa": "kɑːt", "nguon": "cmu"}]}, "vi": ""}]}], "phat_am": "- **bought / brought / thought / caught / taught** đều có nguyên âm /ɔː/, chữ “gh” **câm**: /bɔːt/, /θɔːt/.\n- **said** /sed/ — không đọc “sết” theo mặt chữ.\n- **ate** đọc /eɪt/ hoặc /et/ tùy vùng, đều được chấp nhận.", "luu_y": "**① Bất quy tắc chỉ áp dụng ở câu KHẲNG ĐỊNH.** Có did thì trở lại nguyên thể:\n\n- ✅ I **went**. · ✅ I **didn’t go**. · ✅ **Did** you **go**?\n- ❌ I didn’t went. ❌ Did you went?\n\n**② read – read – read** viết giống nhau nhưng đọc khác: hiện tại /riːd/, quá khứ **/red/**.\nTương tự: **say** /seɪ/ → **said** /sed/.\n\n**③ Cặp dễ nhầm nghĩa:**\n\n- **saw** (nhìn thấy, V2 của see) vs **seen** (V3) — ở Level 1 chỉ dùng saw.\n- **left** = rời đi (V2 của leave) và cũng = bên trái. Phân biệt bằng ngữ cảnh.\n- **found** = tìm thấy (V2 của find), khác **founded** = thành lập (V2 của found).\n\n**④ Cách học 40 động từ hiệu quả:** không học bảng, mà học **trong câu**. Mỗi động từ viết 1 câu về chính mình:\n*I went to Da Nang in 2023. · I bought a new phone last month.*\n\n> Học bảng rời rạc: nhớ được 1 tuần. Học trong câu: nhớ được nhiều tháng.\n\n**⑤ Trật tự kể chuyện quá khứ:** dùng **when / while / after / before** để nối:\n*When I arrived, they were already there. · After I finished work, I went home.*", "meo": "- Học theo **6 nhóm quy luật** ở mục 16.1, mỗi ngày 1 nhóm trong 6 ngày. Ngày 7 ôn cả 40.\n- Nhóm i–a–u nhớ bằng câu: *I dr**i**nk today, I dr**a**nk yesterday, I have dr**u**nk* — nghe như tiếng chuông đổi cao độ.\n- Nhóm -ought/-aught nhớ bằng câu duy nhất: *I **bought** a book, **brought** it home, **thought** about it, and my teacher **taught** me more.*", "bai_tap": [{"ma": "A", "ten": "Viết dạng quá khứ", "cau_hoi": [{"so": 1, "de": "go → 2. buy → 3. take → 4. see → 5. eat → 6. write → 7. drink → 8. teach → 9. leave → 10. find →", "dap_an": "went", "nhan": ["went"]}]}, {"ma": "B", "ten": "Chia động từ", "cau_hoi": [{"so": 2, "de": "She ____ (buy) a new car last month.", "dap_an": "bought", "nhan": ["bought"]}, {"so": 3, "de": "They ____ (not/go) to the party.", "dap_an": "took", "nhan": ["took"]}, {"so": 4, "de": "____ you ____ (see) that film?", "dap_an": "saw", "nhan": ["saw"]}, {"so": 5, "de": "I ____ (take) a taxi because it ____ (rain).", "dap_an": "ate", "nhan": ["ate"]}, {"so": 6, "de": "He ____ (tell) me the truth.", "dap_an": "wrote", "nhan": ["wrote"]}, {"so": 7, "de": "We ____ (not/have) time yesterday.", "dap_an": "drank", "nhan": ["drank"]}]}, {"ma": "C", "ten": "Sửa lỗi", "cau_hoi": [{"so": 8, "de": "I didn’t went to work.", "dap_an": "taught", "nhan": ["taught"]}, {"so": 9, "de": "Did she bought it?", "dap_an": "left", "nhan": ["left"]}, {"so": 10, "de": "He teached me English.", "dap_an": "found", "nhan": ["found"]}, {"so": 11, "de": "They writed a letter.", "dap_an": "bought", "nhan": ["bought"]}]}]}