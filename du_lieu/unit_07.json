noi": "/kən‿aɪ kʌm‿wɪð‿jə təˈmɑːˌrəʊ/", "tho_noi": "kơn-ai-kâm-widh-yơ-tơmarâu", "tu": [{"tu": "Can", "ipa": "kæn", "nguon": "cmu"}, {"tu": "I", "ipa": "aɪ", "nguon": "cmu"}, {"tu": "come", "ipa": "kʌm", "nguon": "cmu"}, {"tu": "with", "ipa": "wɪð", "nguon": "cmu"}, {"tu": "you", "ipa": "juː", "nguon": "cmu"}, {"tu": "tomorrow", "ipa": "təˈmɑːˌrəʊ", "nguon": "cmu"}]}}, {"vai": "A", "en": "Of course. Bring your towel.", "vi": "Tất nhiên rồi. Nhớ mang khăn nhé.", "them": true, "pa": {"cau": "Of course. Bring your towel.", "ipa_day_du": "/ʌv/ /kɔːs/ /brɪŋ/ /jɔː/ /ˈtaʊəl/", "ipa_noi": "/əv kɔːs brɪŋ‿jə ˈtaʊəl/", "tho_noi": "ơv-kos-bring-yơ-taoơl", "tu": [{"tu": "Of", "ipa": "ʌv", "nguon": "cmu"}, {"tu": "course", "ipa": "kɔːs", "nguon": "cmu"}, {"tu": "Bring", "ipa": "brɪŋ", "nguon": "cmu"}, {"tu": "your", "ipa": "jɔː", "nguon": "cmu"}, {"tu": "towel", "ipa": "ˈtaʊəl", "nguon": "cmu"}]}}, {"vai": "B", "en": "Thanks. See you at the pool.", "vi": "Cảm ơn. Hẹn gặp ở bể bơi.", "them": true, "pa": {"cau": "Thanks. See you at the pool.", "ipa_day_du": "/θæŋks/ /siː/ /juː/ /æt/ /ðə/ /puːl/", "ipa_noi": "/θæŋks siː jə ət ðə puːl/", "tho_noi": "thangks-si-yơ-ơt-dhơ-pul", "tu": [{"tu": "Thanks", "ipa": "θæŋks", "nguon": "cmu"}, {"tu": "See", "ipa": "siː", "nguon": "cmu"}, {"tu": "you", "ipa": "juː", "nguon": "cmu"}, {"tu": "at", "ipa": "æt", "nguon": "cmu"}, {"tu": "the", "ipa": "ðə", "nguon": "cmu"}, {"tu": "pool", "ipa": "puːl", "nguon": "cmu"}]}}], "them": true}], "doan_van": [{"ten": "Truyện — Sở thích nấu ăn", "noi_dung": "In my free time, I love cooking because it is very relaxing. I prefer cooking at home to buying fast food. Today, I want to make a hot soup, but I need some fresh carrots. I hate shopping, but I walk to the local market. Unfortunately, the market is closed today. Then, my neighbour Minh sees me in the street. He is good at gardening, so he offers me some fresh carrots. I take the vegetables home happily. Now, I am cooking my warm soup in the kitchen.", "them": true, "dich": {"In my free time, I love cooking because it is very relaxing.": "Vào những lúc rảnh rỗi, tôi rất thích nấu ăn vì việc này giúp tôi thư giãn.", "I prefer cooking at home to buying fast food.": "Tôi thích nấu ăn ở nhà hơn là mua đồ ăn nhanh.", "Today, I want to make a hot soup, but I need some fresh carrots.": "Hôm nay, tôi muốn nấu một món súp nóng, nhưng tôi lại cần vài củ cà rốt tươi.", "I hate shopping, but I walk to the local market.": "Tôi ghét đi mua sắm, nhưng tôi vẫn đi bộ ra chợ gần nhà.", "Unfortunately, the market is closed today.": "Thật không may, hôm nay chợ lại đóng cửa.", "Then, my neighbour Minh sees me in the street.": "Sau đó, Minh, người hàng xóm của tôi, nhìn thấy tôi trên đường.", "He is good at gardening, so he offers me some fresh carrots.": "Anh ấy làm vườn rất giỏi, nên đã cho tôi vài củ cà rốt tươi.", "I take the vegetables home happily.": "Tôi vui vẻ mang số rau củ đó về nhà.", "Now, I am cooking my warm soup in the kitchen.": "Bây giờ, tôi đang nấu món súp ấm nóng của mình trong bếp."}, "cau": [{"en": "In my free time, I love cooking because it is very relaxing.", "pa": {"cau": "In my free time, I love cooking because it is very relaxing.", "ipa_day_du": "/ɪn/ /maɪ/ /friː/ /taɪm/ /aɪ/ /lʌv/ /ˈkʊkɪŋ/ /bɪˈkɔːz/ /ɪt/ /ɪz/ /ˈveriː/ /rɪˈlæksɪŋ/", "ipa_noi": "/ɪn maɪ friː taɪm‿aɪ lʌv ˈkʊkɪŋ bɪˈkɔːz‿ɪt‿ɪz ˈveriː rɪˈlæksɪŋ/", "tho_noi": "in-mai-fri-taim-ai-lâv-kuking-bikoz-it-iz-veri-rilaksing", "tu": [{"tu": "In", "ipa": "ɪn", "nguon": "cmu"}, {"tu": "my", "ipa": "maɪ", "nguon": "cmu"}, {"tu": "free", "ipa": "friː", "nguon": "giao_trinh"}, {"tu": "time", "ipa": "taɪm", "nguon": "giao_trinh"}, {"tu": "I", "ipa": "aɪ", "nguon": "cmu"}, {"tu": "love", "ipa": "lʌv", "nguon": "cmu"}, {"tu": "cooking", "ipa": "ˈkʊkɪŋ", "nguon": "giao_trinh"}, {"tu": "because", "ipa": "bɪˈkɔːz", "nguon": "cmu"}, {"tu": "it", "ipa": "ɪt", "nguon": "cmu"}, {"tu": "is", "ipa": "ɪz", "nguon": "cmu"}, {"tu": "very", "ipa": "ˈveriː", "nguon": "cmu"}, {"tu