du": "/aɪ/ /əˈraɪvd/ /dʒʌst/ /ɪn/ /taɪm/ /tuː/ /stɑːt/ /wɜːk/", "ipa_noi": "/aɪ əˈraɪvd dʒʌst‿ɪn taɪm tə stɑːt‿wɜːk/", "tho_noi": "ai-ơraiv-jâst-in-taim-tơ-stat-wơk", "tu": [{"tu": "I", "ipa": "aɪ", "nguon": "cmu"}, {"tu": "arrived", "ipa": "əˈraɪvd", "nguon": "cmu"}, {"tu": "just", "ipa": "dʒʌst", "nguon": "cmu"}, {"tu": "in", "ipa": "ɪn", "nguon": "cmu"}, {"tu": "time", "ipa": "taɪm", "nguon": "giao_trinh"}, {"tu": "to", "ipa": "tuː", "nguon": "giao_trinh"}, {"tu": "start", "ipa": "stɑːt", "nguon": "cmu"}, {"tu": "work", "ipa": "wɜːk", "nguon": "giao_trinh"}]}, "vi": "Tôi đến nơi vừa kịp lúc để bắt đầu làm việc."}, {"en": "Now, I check my alarm twice a day so I am never late again.", "pa": {"cau": "Now, I check my alarm twice a day so I am never late again.", "ipa_day_du": "/naʊ/ /aɪ/ /tʃek/ /maɪ/ /əˈlɑːm/ /twaɪs/ /ə/ /deɪ/ /səʊ/ /aɪ/ /æm/ /ˈnevə/ /leɪt/ /əˈɡen/", "ipa_noi": "/naʊ aɪ tʃek maɪ əˈlɑːm twaɪs‿ə deɪ səʊ aɪ əm ˈnevə leɪt‿əˈɡen/", "tho_noi": "nao-ai-chek-mai-ơlam-twais-ơ-dây-sâu-ai-ơm-nevơ-lâyt-ơgen", "tu": [{"tu": "Now", "ipa": "naʊ", "nguon": "cmu"}, {"tu": "I", "ipa": "aɪ", "nguon": "cmu"}, {"tu": "check", "ipa": "tʃek", "nguon": "cmu"}, {"tu": "my", "ipa": "maɪ", "nguon": "cmu"}, {"tu": "alarm", "ipa": "əˈlɑːm", "nguon": "cmu"}, {"tu": "twice", "ipa": "twaɪs", "nguon": "cmu"}, {"tu": "a", "ipa": "ə", "nguon": "cmu"}, {"tu": "day", "ipa": "deɪ", "nguon": "cmu"}, {"tu": "so", "ipa": "səʊ", "nguon": "cmu"}, {"tu": "I", "ipa": "aɪ", "nguon": "cmu"}, {"tu": "am", "ipa": "æm", "nguon": "cmu"}, {"tu": "never", "ipa": "ˈnevə", "nguon": "cmu"}, {"tu": "late", "ipa": "leɪt", "nguon": "giao_trinh"}, {"tu": "again", "ipa": "əˈɡen", "nguon": "cmu"}]}, "vi": "Giờ đây, tôi kiểm tra báo thức hai lần một ngày để không bao giờ bị muộn nữa."}]}], "phat_am": "**Nối âm phụ âm + nguyên âm** — đặc trưng của tiếng Anh nói:\n\n- wake **up** → “wei-kʌp”\n- get **up** → “ge-tʌp”\n- pick **it up** → “pi-ki-tʌp”\n\n> Nghe không ra tiếng Anh nói phần lớn là vì chưa quen nối âm, không phải vì thiếu từ vựng.", "luu_y": "**① Vị trí trạng từ tần suất — quy tắc “TRƯỚC động từ thường, SAU động từ to be”.**\n\n- ✅ I **always** get up early. (trước động từ thường)\n- ✅ She **is always** late. (sau to be)\n- ✅ I **can never** remember his name. (sau trợ động từ)\n\n> Đây là lỗi trật tự từ hay gặp: ❌ I get up always early.\n\n**② sometimes có thể đứng đầu hoặc cuối câu** (Sometimes I work late.) — nhưng always/never thì **không**: ❌ Never I drink coffee.\n\n**③ wake up ≠ get up.** wake up = mở mắt tỉnh giấc; get up = ra khỏi giường. Người bản xứ phân biệt rõ.\n\n**④ How often (bao lâu một lần) ≠ How long (mất bao lâu).**\n\n- How often do you exercise? → Twice a week.\n- How long does it take? → About 30 minutes.\n\n**⑤ “It takes + người + thời gian + to V”** — cấu trúc cố định, học nguyên khối:\n*It takes me an hour to finish this.*\n\n**⑥ Không dùng “the” với bữa ăn:** ❌ have the breakfast → ✅ have breakfast.", "meo": "- Học động từ hằng ngày theo **chuỗi thời gian**, không học rời rạc: wake up → get up → brush teeth → take a shower → get dressed → have breakfast → leave home. Kể lại chuỗi này mỗi sáng.\n- Trạng từ tần suất nhớ theo thang %: viết 6 từ lên 1 thước kẻ tưởng tượng từ 0 đến 100.\n- Vị trí: khẩu quyết **“trước thường, sau be”**.", "bai_tap": [{"ma": "A", "ten": "Đặt trạng từ vào đúng vị trí", "cau_hoi": [{"so": 1, "de": "I get up at 6. (usually)", "dap_an": "I usually get up", "nhan": ["i usually get up"]}, {"so": 2, "de": "She is late for work. (never)", "dap_an": "She is never late", "nhan": ["she is never late"]}, {"so": 3, "de": "They go to the cinema. (sometimes)", "dap_an": "They sometimes go / Sometimes they go", "nhan": ["sometimes they go", "they sometimes go"]}, {"so": 4, "de": "He can find his keys. (never)", "dap_an": "He can never find", "nhan": ["he can never find"]}, {"so": 5, "de": "We have dinner at 7. (often)", "dap_an": "We often have", "nhan": ["we often have"]}]}, {"ma": "B", "ten": "How often / How long", "cau_hoi": [{"so": 6, "de": "____ do you go to the gym? — Twice a week.", "dap_an": "How often", "nhan": ["how often"]}, {"so": 7, "de": "____ does it take to get there? — Half an hour.", "dap_an": "How long", "nhan": ["how long"]}, {"so": 8, "de": "____ do you visit your parents? — Every month.", "dap_an": "How often", "nhan": ["how often"]}]}, {"ma": "C", "ten": "Sửa lỗi", "cau_hoi": [{"so": 9, "de": "I drink never beer.", "dap_an": "I never drink beer", "nhan": ["i never drink beer"]}, {"so": 10, "de": "It takes me 20 minutes for go to work.", "dap_an": "…20 minutes to go to work", "nhan": ["20 minutes to go to work"]}, {"so": 11, "de": "I have the breakfast at 7.", "dap_an": "I have breakfast (bỏ the)", "nhan": ["i have breakfast", "i have breakfast (bỏ the)", "i have breakfast bỏ the"]}, {"so": 12, "de": "She always is busy.", "dap_an": "She is always busy", "nhan": ["she is always busy"]}]}]}